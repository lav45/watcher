{
    "name": "lav45/watcher",
    "version": "1.0.1",
    "type": "library",
    "description": "File change watcher",
    "keywords": [
        "php",
        "file",
        "change",
        "watcher"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksey Loban",
            "email": "lav451@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-inotify": "*"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8"
    },
    "scripts": {
        "test": "php -d opcache.enable_cli=off vendor/bin/phpunit",
        "code-style": "PHP_CS_FIXER_IGNORE_ENV=1 php -d opcache.enable_cli=off vendor/bin/php-cs-fixer fix"
    },
    "autoload": {
        "psr-4": {
            "Lav45\\Watcher\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lav45\\Watcher\\Test\\": "test"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "bamarni-bin": {
            "bin-links": true,
            "target-directory": "tools",
            "forward-command": true
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    }
}